; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="Bureaucrats & Broomsticks"
; THE NUMBER A BUG REPORT NAMES. It travels in every report (scripts/BugReport.cs) and is the only thing that
; says which build a player was holding — raise it when a build goes to anyone who is not sitting here.
config/version="0.1.0"
run/main_scene="res://scenes/Boot.tscn"
config/features=PackedStringArray("4.7", "C#")

[dotnet]

project/assembly_name="BnbGodot"

[autoload]

GameHost="*res://scripts/GameHost.cs"

[display]

; THE DESIGN CANVAS. Every coordinate in the frontend is a unit of THIS 1280 x 720 page — a card is 134 x 190
; here and at every window size, because `canvas_items` scales the whole page instead of the game doing
; arithmetic. `expand` means a window that is not 16:9 gets a WIDER (or taller) page rather than black bars,
; so an ultrawide screen hands the extra room to the combat pane; that is why the pane is built out of
; anchored regions (SessionScreen) and not measured against 1280. The player's own choices — window size,
; fullscreen, and an interface scale on top of all of it — live in scripts/DisplaySettings.cs.
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[importer_defaults]

; ⚠ A DROPPED PICTURE IS IMPORTED WITHOUT MIPMAPS unless this says otherwise, and every picture in this game
; is drawn much smaller than it is painted — a 488x440 card illustration lands in a 122x110 window. Without a
; mip chain that reduction is the glitter D1 already paid for once, and nobody dropping a file in would think
; to open its .import to find out why. This is the default for NEW imports only; the files that carry the
; setting themselves keep it.
texture={
"mipmaps/generate": true
}
