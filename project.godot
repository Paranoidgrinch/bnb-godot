; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="Bureaucrats & Broomsticks"
run/main_scene="res://scenes/Boot.tscn"
config/features=PackedStringArray("4.7", "C#")

[dotnet]

project/assembly_name="BnbGodot"

[autoload]

GameHost="*res://scripts/GameHost.cs"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[importer_defaults]

; ⚠ A DROPPED PICTURE IS IMPORTED WITHOUT MIPMAPS unless this says otherwise, and every picture in this game
; is drawn much smaller than it is painted — a 488x440 card illustration lands in a 122x110 window. Without a
; mip chain that reduction is the glitter D1 already paid for once, and nobody dropping a file in would think
; to open its .import to find out why. This is the default for NEW imports only; the files that carry the
; setting themselves keep it.
texture={
"mipmaps/generate": true
}
